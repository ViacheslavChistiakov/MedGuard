# Secret used by NextAuth to encrypt session cookies/tokens.
AUTH_SECRET=replace-with-a-long-random-string

# Where the frontend reaches the Express API, and this app's own public URL.
NEXT_PUBLIC_API_URL=http://localhost:4000
APP_URL=http://localhost:3000

# Must match the API server's INTERNAL_API_SECRET.
INTERNAL_API_SECRET=replace-with-a-long-random-string

# From https://console.cloud.google.com/apis/credentials — create an OAuth
# Client ID (Web application) with redirect URI:
# http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# For YooKassa integration: base64("shopId:secretKey") from your shop's API
# keys page (https://yookassa.ru/my/api-keys-and-services/api-keys) - used
# directly as the "Authorization: Basic <value>" header, no decoding needed.
# Also register the webhook URL there: {APP_URL}/api/payments/yookassa/result
YOOKASSA_AUTH=

# Plan prices are stored and displayed in USD; the actual USD->RUB rate used
# when charging via YooKassa (which settles only in rubles) is fetched live
# from the Central Bank of Russia. This is just the fallback used if that
# live lookup fails - update it occasionally so it doesn't drift too far.
USD_TO_RUB_RATE=83

# From https://resend.com/api-keys. RESEND_FROM_EMAIL defaults to Resend's
# sandbox sender (onboarding@resend.dev, no domain verification needed) if
# left unset - swap it for an address on your own verified domain later.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
