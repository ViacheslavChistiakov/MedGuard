PORT=4000

# MongoDB Atlas connection string and database name.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=MedGuard
MONGODB_DB_NAME=MedGuard

# Secret used to sign/verify API JWTs, and how long issued tokens last.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Shared secret the Next.js app must send (as `x-internal-secret`) to reach
# internal-only endpoints (OAuth login, marking orders paid).
INTERNAL_API_SECRET=replace-with-a-long-random-string
